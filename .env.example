# Copy to .env and fill in. Netlify holds the real values as environment
# variables; nothing here belongs in version control.

# Unguessable path segments for the two private pages
GUEST_SLUG=preview-guide
ADMIN_SLUG=preview-admin

# Printed inside the guest guide
WIFI_PASSWORD=CHANGE_ME

# Password gate on the owner calendar
ADMIN_PASSWORD=CHANGE_ME

# Read-only iCal exports from the listings
ICAL_AIRBNB=
ICAL_BOOKING=

# Booking rules mirrored from the listing
MIN_STAY=2
ADVANCE_NOTICE_DAYS=3
